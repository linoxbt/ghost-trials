{
    email {$ACME_EMAIL}
}
{$GHOST_DOMAIN} {
    # Physical recordings upload in 256 KiB chunks; the API enforces its own exact per-route limits.
    @physicalUpload path /physical/sessions/*/artifacts/*
    request_body @physicalUpload {
        max_size 320KB
    }
    @otherRequests not path /physical/sessions/*/artifacts/*
    request_body @otherRequests {
        max_size 16KB
    }
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
    }
    @preview path /artifacts/*
    header @preview X-Frame-Options "SAMEORIGIN"
    @notPreview not path /artifacts/*
    header @notPreview X-Frame-Options "DENY"
    reverse_proxy dashboard:8000
}
