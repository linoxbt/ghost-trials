GHOST_MODE=production
GHOST_DATA_PATH=/data/dashboard/state.json
GHOST_ARTIFACT_ROOT=/data/dashboard/artifacts
GHOST_SCENARIO_PROVIDER=cosmos
GHOST_SIMULATOR_PROVIDER=isaac_http
GHOST_JUDGE_PROVIDER=nebius

# Access tokens are supplied by private/access.env in secure.compose.yaml.
GHOST_ALLOWED_ORIGINS=https://ghost-trials.netlify.app,https://backend.example.com
GHOST_LIVE_EXECUTION_ENABLED=false
GHOST_MAX_PENDING_JOBS=10
GHOST_MAX_JOBS_PER_DAY=20
GHOST_MAX_REQUESTS_PER_MINUTE=60
GHOST_JOB_TIMEOUT_SECONDS=3900
GHOST_SESSION_SECONDS=3600
GHOST_COOKIE_SECURE=true
GHOST_MODEL_MAX_TOKENS=2048

# Permanent DNS for secure.compose.yaml; never use a quick-tunnel hostname.
GHOST_DOMAIN=backend.example.com
ACME_EMAIL=operator@example.com
# Optional private S3 evidence replica; standard AWS credential environment.
GHOST_ARTIFACT_BUCKET=
GHOST_S3_ENDPOINT=
GHOST_S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
GHOST_ALERT_WEBHOOK=

NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEBIUS_SUPER_MODEL=nvidia/nemotron-3-super-120b-a12b
NEBIUS_ULTRA_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b

SCENARIO_REASONER_BASE_URL=https://api.tokenfactory.nebius.com/v1/
SCENARIO_REASONER_API_KEY=
SCENARIO_REASONER_MODEL=nvidia/nemotron-3-super-120b-a12b

COSMOS_BASE_URL=
COSMOS_API_KEY=
COSMOS_API_STYLE=nvidia_catalog
# Hosted Cosmos3 Nano: obtain NVIDIA_API_KEY through the NVIDIA API Catalog.
# A private NIM deployment instead requires COSMOS_API_STYLE=nim and COSMOS_BASE_URL.
NVIDIA_API_KEY=
COSMOS_RESOLUTION=480_16_9
COSMOS_NUM_FRAMES=25
COSMOS_FPS=24
COSMOS_STEPS=35
COSMOS_GUIDANCE_SCALE=6
COSMOS_TIMEOUT_SECONDS=1800

ISAAC_JOB_ENDPOINT=https://your-isaac-worker.example/
ISAAC_JOB_TOKEN=
ISAAC_JOB_TIMEOUT_SECONDS=1800
ISAAC_POLL_INTERVAL_SECONDS=2
ISAAC_WORKER_EXPECTED_BACKEND=gear_sonic_sim
ISAAC_WORKER_EXPECTED_COMMIT=
GR00T_CHECKPOINT=/models/g1-sonic/checkpoint-final
GR00T_CHECKPOINT_DIGEST=
GR00T_POLICY_HOST=127.0.0.1
GR00T_POLICY_PORT=5550
GHOST_EXECUTION_BACKEND=gear_sonic_sim

# GPU worker only
ISAAC_WORKER_TOKEN=
ISAAC_WORKER_BACKEND=gear_sonic_sim
ISAAC_WORKER_REQUIRE_GPU=true
ISAAC_WORKER_REQUIRE_POLICY=true
ISAAC_WORKER_ALLOW_UNAUTHENTICATED=false
ISAAC_WORKER_PUBLIC_BASE_URL=https://your-isaac-worker.example
ISAAC_WORKER_OUTPUT_ROOT=/data/ghost-trials
ISAAC_RUNNER_COMMAND='python /app/workers/isaac/trial_runner.py'
ISAAC_RUNNER_TIMEOUT_SECONDS=1800
ROBOTICS_WORKDIR=/opt/robotics
GEAR_SONIC_SIM_COMMAND='/app/scripts/run_sonic_trial.sh --request {request} --output {output}'
# Alternative Arena backend:
# ISAAC_ARENA_COMMAND='/app/scripts/run_arena_trial.sh --request {request} --output {output}'
# Individual authentication; email/Google and domains must be enabled in Privy.
PRIVY_APP_ID=
PRIVY_CLIENT_ID=
PRIVY_VERIFICATION_KEY=
GHOST_CUSTOMER_AUTH_REQUIRED=true
GHOST_PUBLIC_SIGNUP_ENABLED=true
GHOST_PRIVY_SESSION_SECONDS=3600
# Both budget layers must be allocated before a live request is accepted.
GHOST_PLATFORM_BUDGET_CENTS=0
GHOST_LIVE_JOB_RESERVATION_CENTS=0
GHOST_PROVIDER_SPENDING_CONTROLS_CONFIRMED=false
