GHOST_MODE=local
GHOST_DATA_PATH=data/state.json
GHOST_ARTIFACT_ROOT=artifacts/generated
GHOST_PIPELINE_DELAY_SECONDS=0.35
GHOST_SCENARIO_PROVIDER=local
GHOST_SIMULATOR_PROVIDER=local

# Optional Nebius judge mode
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEBIUS_SUPER_MODEL=nvidia/nemotron-3-super-120b-a12b
NEBIUS_ULTRA_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b
GHOST_JUDGE_PROVIDER=local

# Reserved for the production Cosmos adapter
NVIDIA_API_KEY=

# Production Cosmos 3 generator: nim or vllm
COSMOS_BASE_URL=
COSMOS_API_KEY=
COSMOS_API_STYLE=nim
COSMOS_TIMEOUT_SECONDS=1800
COSMOS_RESOLUTION=480_16_9
COSMOS_NUM_FRAMES=121
COSMOS_FPS=24
COSMOS_STEPS=35
COSMOS_GUIDANCE_SCALE=6

# OpenAI-compatible structured-scenario reasoner (Nebius Token Factory by default)
SCENARIO_REASONER_BASE_URL=https://api.tokenfactory.nebius.com/v1/
SCENARIO_REASONER_API_KEY=
SCENARIO_REASONER_MODEL=nvidia/nemotron-3-super-120b-a12b

# Isaac GPU worker and fine-tuned policy
ISAAC_JOB_ENDPOINT=
ISAAC_JOB_TOKEN=
ISAAC_JOB_TIMEOUT_SECONDS=1800
ISAAC_POLL_INTERVAL_SECONDS=2
ISAAC_WORKER_EXPECTED_BACKEND=
ISAAC_WORKER_EXPECTED_COMMIT=
GR00T_CHECKPOINT=
GR00T_CHECKPOINT_DIGEST=
GR00T_POLICY_HOST=127.0.0.1
GR00T_POLICY_PORT=5550
GHOST_EXECUTION_BACKEND=isaac_arena_gr00t
