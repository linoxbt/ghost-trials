GHOST_MODE=cpu
# Choose privy (existing) or dynamic (Dynamic.xyz email/Google).
GHOST_AUTH_PROVIDER=privy
# Public ID only. Verification uses Privy's fixed HTTPS JWKS endpoint by default.
PRIVY_APP_ID=
PRIVY_CLIENT_ID=
# Optional pinned public verification PEM; never a private signing key.
PRIVY_VERIFICATION_KEY=
# For Dynamic, set GHOST_AUTH_PROVIDER=dynamic; the environment ID is public.
# Set the JWT audience to the exact HTTPS frontend origin configured in Dynamic.
DYNAMIC_ENVIRONMENT_ID=
DYNAMIC_JWT_AUDIENCE=
GHOST_CUSTOMER_AUTH_REQUIRED=false
GHOST_UNAUTHENTICATED_LOCAL_DEV=false
# Set true only on an internet-facing backend; startup then requires individual
# sign-in, secure cookies, and exact HTTPS allowed origins.
GHOST_PUBLIC_DEPLOYMENT=false
GHOST_PUBLIC_SIGNUP_ENABLED=true
# Legacy name; bounds the server session for either identity provider.
GHOST_PRIVY_SESSION_SECONDS=3600
GHOST_PLATFORM_BUDGET_CENTS=0
GHOST_LIVE_JOB_RESERVATION_CENTS=0
GHOST_PROVIDER_SPENDING_CONTROLS_CONFIRMED=false
GHOST_DATA_PATH=data/state.json
GHOST_ARTIFACT_ROOT=artifacts/generated
GHOST_PIPELINE_DELAY_SECONDS=0.35
GHOST_SCENARIO_PROVIDER=cpu
GHOST_SIMULATOR_PROVIDER=mujoco_cpu
GHOST_POLICY_NAME=gantry-push-v1
# Optional server-side directory of validated ghost-cpu-mlp-v1 JSON policies.
# GHOST_CPU_POLICY_DIR=/absolute/path/to/cpu-policies

# Optional Nebius judge mode
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEBIUS_SUPER_MODEL=nvidia/nemotron-3-super-120b-a12b
NEBIUS_ULTRA_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b
GHOST_JUDGE_PROVIDER=cpu
# Optional model interpretation after each artifact-verified CPU trial.
# Leave disabled until the Nebius account has credit-only use or a confirmed
# provider-side limit, and the operator allocates an organization budget.
GHOST_CPU_MODEL_REVIEW_ENABLED=false
# Optional, explicit Nemotron interpretation of a verified agent trace.
# Uses the same per-call reservation and organization/platform budgets below.
GHOST_AGENT_MODEL_REVIEW_ENABLED=false
GHOST_CPU_MODEL_REVIEW_RESERVATION_CENTS=10
GHOST_CPU_MODEL_REVIEW_MAX_TOKENS=512
GHOST_CPU_MODEL_REVIEW_TIMEOUT_SECONDS=20

# NVIDIA API Catalog key for hosted Cosmos; never expose to the frontend.
NVIDIA_API_KEY=

# Cosmos 3: nvidia_catalog (hosted, no local GPU), nim, or vllm.
# Hosted setup: COSMOS_API_STYLE=nvidia_catalog, COSMOS_NUM_FRAMES=25.
# COSMOS_BASE_URL may be empty in hosted mode (uses https://ai.api.nvidia.com/).
COSMOS_BASE_URL=
COSMOS_API_KEY=
COSMOS_API_STYLE=nim
COSMOS_TIMEOUT_SECONDS=1800
COSMOS_RESOLUTION=480_16_9
COSMOS_NUM_FRAMES=121
COSMOS_FPS=24
COSMOS_STEPS=35
COSMOS_GUIDANCE_SCALE=6

# OpenAI-compatible structured-scenario reasoner (Nebius Token Factory by default)
SCENARIO_REASONER_BASE_URL=https://api.tokenfactory.nebius.com/v1/
SCENARIO_REASONER_API_KEY=
SCENARIO_REASONER_MODEL=nvidia/nemotron-3-super-120b-a12b

# Isaac GPU worker and fine-tuned policy
ISAAC_JOB_ENDPOINT=
ISAAC_JOB_TOKEN=
ISAAC_JOB_TIMEOUT_SECONDS=1800
ISAAC_POLL_INTERVAL_SECONDS=2
ISAAC_WORKER_EXPECTED_COMMIT=
GR00T_CHECKPOINT=
GR00T_CHECKPOINT_DIGEST=
GR00T_POLICY_HOST=127.0.0.1
GR00T_POLICY_PORT=5550
GHOST_EXECUTION_BACKEND=mujoco_cpu

# Private single-organization deployment; generate tokens with access_setup.
GHOST_ADMIN_TOKEN=
GHOST_OPERATOR_TOKEN=
GHOST_VIEWER_TOKEN=
GHOST_ALLOWED_ORIGINS=
GHOST_COOKIE_SECURE=true
GHOST_LIVE_EXECUTION_ENABLED=false
# Platform-wide backstops.
GHOST_MAX_PENDING_JOBS=10
GHOST_MAX_JOBS_PER_DAY=300
# What one workspace may use, so a single (possibly self-registered) user cannot exhaust the platform.
GHOST_MAX_ORG_PENDING_JOBS=2
GHOST_MAX_ORG_JOBS_PER_DAY=40
# What one signed-in person may use across all of their workspaces (deployment tokens are exempt).
GHOST_MAX_SUBJECT_PENDING_JOBS=2
GHOST_MAX_SUBJECT_JOBS_PER_DAY=60
GHOST_MAX_REQUESTS_PER_MINUTE=60
# Anonymous requests are limited per client address, with a platform backstop. Sign-in counts only
# *failed* credentials, after verification, so a flood of junk tokens can never block a valid sign-in.
GHOST_MAX_ANONYMOUS_REQUESTS_PER_MINUTE=600
GHOST_MAX_CLIENT_AUTH_ATTEMPTS_PER_MINUTE=10
GHOST_MAX_AUTH_ATTEMPTS_PER_MINUTE=60
# Reverse proxies that append X-Forwarded-For in front of the API (verify in request logs). 0 = client
# addresses are unknown behind a proxy; only platform-wide counters apply.
GHOST_TRUSTED_PROXY_HOPS=0
# On Railway the API refuses to start unless state and artifacts are on the attached volume.
GHOST_REQUIRE_PERSISTENT_DATA=true
GHOST_JOB_TIMEOUT_SECONDS=3900
GHOST_MODEL_MAX_TOKENS=2048

# Physical capture is read-only; uploads are private and never command a robot.
GHOST_PHYSICAL_MAX_BUNDLE_BYTES=268435456
GHOST_PHYSICAL_DISK_RESERVE_BYTES=1073741824
# Declared bytes of uploading + validated recordings, per workspace and platform-wide; cancelled,
# abandoned (after the TTL) and deleted (DELETE /physical/sessions/<id>) sessions free their bytes.
GHOST_PHYSICAL_ORG_STORAGE_BYTES=1073741824
GHOST_PHYSICAL_PLATFORM_STORAGE_BYTES=4294967296
GHOST_PHYSICAL_PENDING_TTL_SECONDS=86400
GHOST_PHYSICAL_MAX_CHUNKS_PER_MINUTE=240
