GHOST_MODE=local
# Public ID only. Verification uses Privy's fixed HTTPS JWKS endpoint by default.
PRIVY_APP_ID=
PRIVY_CLIENT_ID=
# Optional pinned public verification PEM; never a private signing key.
PRIVY_VERIFICATION_KEY=
GHOST_CUSTOMER_AUTH_REQUIRED=false
GHOST_PUBLIC_SIGNUP_ENABLED=true
GHOST_PRIVY_SESSION_SECONDS=3600
GHOST_PLATFORM_BUDGET_CENTS=0
GHOST_LIVE_JOB_RESERVATION_CENTS=0
GHOST_PROVIDER_SPENDING_CONTROLS_CONFIRMED=false
GHOST_DATA_PATH=data/state.json
GHOST_ARTIFACT_ROOT=artifacts/generated
GHOST_PIPELINE_DELAY_SECONDS=0.35
GHOST_SCENARIO_PROVIDER=local
GHOST_SIMULATOR_PROVIDER=local

# Optional Nebius judge mode
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEBIUS_SUPER_MODEL=nvidia/nemotron-3-super-120b-a12b
NEBIUS_ULTRA_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b
GHOST_JUDGE_PROVIDER=local

# NVIDIA API Catalog key for hosted Cosmos; never expose to the frontend.
NVIDIA_API_KEY=

# Cosmos 3: nvidia_catalog (hosted, no local GPU), nim, or vllm.
# Hosted setup: COSMOS_API_STYLE=nvidia_catalog, COSMOS_NUM_FRAMES=25.
# COSMOS_BASE_URL may be empty in hosted mode (uses https://ai.api.nvidia.com/).
COSMOS_BASE_URL=
COSMOS_API_KEY=
COSMOS_API_STYLE=nim
COSMOS_TIMEOUT_SECONDS=1800
COSMOS_RESOLUTION=480_16_9
COSMOS_NUM_FRAMES=121
COSMOS_FPS=24
COSMOS_STEPS=35
COSMOS_GUIDANCE_SCALE=6

# OpenAI-compatible structured-scenario reasoner (Nebius Token Factory by default)
SCENARIO_REASONER_BASE_URL=https://api.tokenfactory.nebius.com/v1/
SCENARIO_REASONER_API_KEY=
SCENARIO_REASONER_MODEL=nvidia/nemotron-3-super-120b-a12b

# Isaac GPU worker and fine-tuned policy
ISAAC_JOB_ENDPOINT=
ISAAC_JOB_TOKEN=
ISAAC_JOB_TIMEOUT_SECONDS=1800
ISAAC_POLL_INTERVAL_SECONDS=2
ISAAC_WORKER_EXPECTED_BACKEND=
ISAAC_WORKER_EXPECTED_COMMIT=
GR00T_CHECKPOINT=
GR00T_CHECKPOINT_DIGEST=
GR00T_POLICY_HOST=127.0.0.1
GR00T_POLICY_PORT=5550
GHOST_EXECUTION_BACKEND=isaac_arena_gr00t

# Private single-organization deployment; generate tokens with access_setup.
GHOST_ADMIN_TOKEN=
GHOST_OPERATOR_TOKEN=
GHOST_VIEWER_TOKEN=
GHOST_ALLOWED_ORIGINS=
GHOST_COOKIE_SECURE=true
GHOST_LIVE_EXECUTION_ENABLED=false
GHOST_MAX_PENDING_JOBS=10
GHOST_MAX_JOBS_PER_DAY=20
GHOST_MAX_REQUESTS_PER_MINUTE=60
GHOST_JOB_TIMEOUT_SECONDS=3900
GHOST_MODEL_MAX_TOKENS=2048

# Physical capture is read-only; uploads are private and never command a robot.
GHOST_PHYSICAL_MAX_BUNDLE_BYTES=268435456
GHOST_PHYSICAL_DISK_RESERVE_BYTES=1073741824
GHOST_PHYSICAL_MAX_CHUNKS_PER_MINUTE=240
