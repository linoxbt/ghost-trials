{
  "name": "pro-videos",
  "version": "1.0.0",
  "description": "My Remotion video",
  "repository": {},
  "license": "UNLICENSED",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.536",
    "@remotion/google-fonts": "^4.0.536",
    "@remotion/media-utils": "^4.0.536",
    "@remotion/paths": "^4.0.536",
    "@remotion/shapes": "^4.0.536",
    "@remotion/transitions": "^4.0.536",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.536"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.536",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "studio": "remotion studio --no-open --port 3000",
    "vo": "node scripts/voiceover.mjs",
    "timing": "node scripts/timing.mjs",
    "music": "node scripts/music.mjs",
    "sfx": "node scripts/sfx.mjs",
    "audio": "npm run vo && npm run music && npm run sfx && npm run timing",
    "draft": "npm run timing && remotion render GhostTrials out/draft.mp4 --scale 0.5 --crf 28 --concurrency 1",
    "render": "npm run timing && remotion render GhostTrials out/ghost-trials-1080p.mp4 --codec h264 --crf 18 --image-format png --pixel-format yuv420p --audio-codec aac --audio-bitrate 320k --concurrency 1",
    "poster": "remotion still Poster out/poster.png",
    "voices": "node scripts/voices.mjs",
    "audition": "node scripts/audition.mjs",
    "vofx": "node scripts/vofx.mjs",
    "data": "node scripts/data.mjs",
    "capture": "node scripts/capture.mjs",
    "visuals": "node scripts/visuals.mjs",
    "encode": "node scripts/encode.mjs",
    "finish": "node scripts/finish.mjs",
    "stills": "node scripts/stills.mjs 0 120 400",
    "sheet": "node scripts/sheet.mjs",
    "final": "node scripts/final.mjs",
    "render4k": "if [ \"${FINAL_4K:-}\" = \"1\" ]; then remotion render GhostTrials out/ghost-trials-4k.mp4 --scale 2 --codec h264 --crf 18 --image-format png --pixel-format yuv420p --audio-codec aac --audio-bitrate 320k --concurrency 1; else echo \"4K skipped\"; fi"
  },
  "allowScripts": {
    "esbuild": false
  }
}
